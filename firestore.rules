rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Checks shared by create and update (the document as it would be saved).
    function validCampsite(d) {
      return d.keys().hasAll([
          'id', 'ownerId', 'name', 'location',
          'maxOccupancy', 'pricePerNight'
        ])
        && d.keys().hasOnly([
          'id', 'ownerId', 'name', 'location',
          'maxOccupancy', 'pricePerNight',
          'rating', 'ratingCount', 'description', 'amenities',
          'latitude', 'longitude', 'imageUrl', 'rules',
          'cancellationPolicy', 'geographicFeature'
        ])
        && d.name is string
        && d.name.size() > 0
        && d.name.size() <= 200
        && d.location is string
        && d.location.size() > 0
        && d.location.size() <= 500
        && d.maxOccupancy is int
        && d.maxOccupancy > 0
        && d.pricePerNight is number
        && d.pricePerNight >= 0
        && d.pricePerNight <= 100000
        // optional details: never required, only checked when present
        && d.get('description', '') is string
        && d.get('description', '').size() <= 2000
        && d.get('rules', '') is string
        && d.get('rules', '').size() <= 2000
        && d.get('cancellationPolicy', '') is string
        && d.get('cancellationPolicy', '').size() <= 2000
        && d.get('amenities', []) is list
        && d.get('amenities', []).size() <= 20
        && d.get('geographicFeature', []) is list
        && d.get('imageUrl', null) == null || d.get('imageUrl', null) is string;
    }

    function validLocation(d) {
      return (d.get('latitude', null) == null) == (d.get('longitude', null) == null)
        && (d.get('latitude', null) == null
            || (d.latitude is number && d.latitude >= -90 && d.latitude <= 90))
        && (d.get('longitude', null) == null
            || (d.longitude is number && d.longitude >= -180 && d.longitude <= 180));
    }

    match /campsites/{campsiteId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && validCampsite(request.resource.data)
        && validLocation(request.resource.data)
        && request.resource.data.id == campsiteId
        && request.resource.data.ownerId == request.auth.uid
        // ratings come from reviews, never from the owner
        && request.resource.data.get('rating', 0) == 0
        && request.resource.data.get('ratingCount', 0) == 0;

      // owner only; id, ownerId and the rating fields can't change
      allow update: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && validCampsite(request.resource.data)
        && validLocation(request.resource.data)
        && !request.resource.data.diff(resource.data)
            .affectedKeys().hasAny(['id', 'ownerId', 'rating', 'ratingCount']);

      // change to `resource.data.ownerId == request.auth.uid` if you add owner delete
      allow delete: if false;
    }
  }
}