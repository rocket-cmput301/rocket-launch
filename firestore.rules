rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Checks shared by create and update (the document as it would be saved).
    function validCampsite(d) {
      return d.keys().hasAll([
          'id', 'ownerId', 'name', 'location',
          'maxOccupancy', 'pricePerNight'
        ])
        && d.keys().hasOnly([
          'id', 'ownerId', 'name', 'location',
          'maxOccupancy', 'pricePerNight',
          'rating', 'ratingCount', 'description', 'amenities',
          'latitude', 'longitude', 'imageUrl', 'rules',
          'cancellationPolicy', 'geographicFeature',
          'availableFrom', 'availableTo'
        ])
        && d.name is string
        && d.name.size() > 0
        && d.name.size() <= 200
        && d.location is string
        && d.location.size() > 0
        && d.location.size() <= 500
        && d.maxOccupancy is int
        && d.maxOccupancy > 0
        && d.pricePerNight is number
        && d.pricePerNight >= 0
        && d.pricePerNight <= 100000
        // optional details: never required, only checked when present
        && d.get('description', '') is string
        && d.get('description', '').size() <= 2000
        && d.get('rules', '') is string
        && d.get('rules', '').size() <= 2000
        && d.get('cancellationPolicy', '') is string
        && d.get('cancellationPolicy', '').size() <= 2000
        && d.get('amenities', []) is list
        && d.get('amenities', []).size() <= 20
        && d.get('geographicFeature', []) is list
        && d.get('availableFrom', '') is string
        && d.get('availableTo', '') is string
        && (d.get('imageUrl', null) == null || d.get('imageUrl', null) is string);
    }

    function validLocation(d) {
      return (d.get('latitude', null) == null) == (d.get('longitude', null) == null)
        && (d.get('latitude', null) == null
            || (d.latitude is number && d.latitude >= -90 && d.latitude <= 90))
        && (d.get('longitude', null) == null
            || (d.longitude is number && d.longitude >= -180 && d.longitude <= 180));
    }

    match /campsites/{campsiteId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && validCampsite(request.resource.data)
        && validLocation(request.resource.data)
        && request.resource.data.id == campsiteId
        && request.resource.data.ownerId == request.auth.uid
        // ratings come from reviews, never from the owner
        && request.resource.data.get('rating', 0) == 0
        && request.resource.data.get('ratingCount', 0) == 0;

      // owner only; id, ownerId and the rating fields can't change
      allow update: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && validCampsite(request.resource.data)
        && validLocation(request.resource.data)
        && !request.resource.data.diff(resource.data)
            .affectedKeys().hasAny(['id', 'ownerId', 'rating', 'ratingCount']);

      // change to `resource.data.ownerId == request.auth.uid` if you add owner delete
      allow delete: if false;
    }

    // Bookings. The entrant creates them; the entrant and the campsite owner can read them.
    match /reservations/{reservationId} {
      allow read: if request.auth != null
        && (resource.data.entrantId == request.auth.uid
            || resource.data.ownerId == request.auth.uid);

      allow create: if request.auth != null
        && request.resource.data.keys().hasAll([
             'id', 'campsiteId', 'ownerId', 'entrantId',
             'checkInDate', 'checkOutDate', 'numberOfGuests', 'totalPrice'
           ])
        && request.resource.data.keys().hasOnly([
             'id', 'campsiteId', 'ownerId', 'entrantId',
             'checkInDate', 'checkOutDate', 'numberOfGuests', 'totalPrice', 'status'
           ])
        && request.resource.data.get('status', 'confirmed') == 'confirmed'
        && request.resource.data.id == reservationId
        && request.resource.data.entrantId == request.auth.uid
        // ownerId must be the real owner of the campsite being booked
        && request.resource.data.ownerId ==
             get(/databases/$(database)/documents/campsites/$(request.resource.data.campsiteId)).data.ownerId
        && request.resource.data.checkInDate is string
        && request.resource.data.checkOutDate is string
        && request.resource.data.checkInDate < request.resource.data.checkOutDate
        && request.resource.data.numberOfGuests is int
        && request.resource.data.numberOfGuests > 0
        && request.resource.data.totalPrice is number
        && request.resource.data.totalPrice >= 0;

      // the campsite owner can reject a booking; only the status changes, and only once
      allow update: if request.auth != null
        && resource.data.ownerId == request.auth.uid
        && resource.data.get('status', 'confirmed') != 'rejected'
        && request.resource.data.status == 'rejected'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);

      allow delete: if false;
    }

    // One document per booked night, id "{campsiteId}_{yyyy-MM-dd}".
    // Create-only, so a night that is already taken can't be booked again.
    match /bookedNights/{nightId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.keys().hasOnly(['campsiteId', 'reservationId', 'entrantId', 'date'])
        && request.resource.data.entrantId == request.auth.uid
        && nightId == request.resource.data.campsiteId + '_' + request.resource.data.date;

      // the campsite owner frees the nights of a reservation they reject
      allow delete: if request.auth != null
        && get(/databases/$(database)/documents/campsites/$(resource.data.campsiteId)).data.ownerId
             == request.auth.uid;

      allow update: if false;
    }
  }
}
