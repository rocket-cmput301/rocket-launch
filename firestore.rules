rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    match /campsites/{campsiteId} {
      allow read: if request.auth != null;

      allow create: if request.auth != null
        && request.resource.data.keys().hasAll([
          'id', 'ownerId', 'name', 'location',
          'maxOccupancy', 'pricePerNight'
        ])
        && request.resource.data.keys().hasOnly([
          'id', 'ownerId', 'name', 'location',
          'maxOccupancy', 'pricePerNight'
        ])
        && request.resource.data.id == campsiteId
        && request.resource.data.ownerId == request.auth.uid
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0
        && request.resource.data.name.size() <= 200
        && request.resource.data.location is string
        && request.resource.data.location.size() > 0
        && request.resource.data.location.size() <= 500
        && request.resource.data.maxOccupancy is int
        && request.resource.data.maxOccupancy > 0
        && request.resource.data.pricePerNight is number
        && request.resource.data.pricePerNight >= 0
        && request.resource.data.pricePerNight <= 100000;

      allow update, delete: if false;
    }
  }
}